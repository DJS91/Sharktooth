<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/colorSettingControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="vertical">
            <View
                android:id="@+id/colorSettingSwatch"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_color_bar_swatch" />
            <TextView
                android:id="@+id/colorSettingTitle"
                style="@style/ColorSettingTitle"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <SeekBar
                android:id="@+id/colorSettingHue"
                style="@style/Widget.OpenDiKey.ColorSeekBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/color_hue"
                android:minHeight="12dp"
                android:maxHeight="12dp"
                android:max="360" />
            <TextView
                android:id="@+id/colorSettingHex"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:fontFamily="monospace"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout style="@style/ColorSettingRow">
            <TextView android:id="@+id/colorSettingSaturationLabel" style="@style/ColorSettingLabel" />
            <SeekBar android:id="@+id/colorSettingSaturation" style="@style/ColorSettingSeek"
                android:contentDescription="@string/color_saturation" android:max="100" />
        </LinearLayout>
        <LinearLayout style="@style/ColorSettingRow">
            <TextView
                android:id="@+id/colorSettingModeLabel"
                style="@style/ColorSettingLabel"
                android:layout_width="48dp"
                android:text="@string/color_mode" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/colorSettingMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:contentDescription="@string/color_mode"
                app:checkedButton="@id/colorSettingModeSolid"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colorSettingModeOff"
                    style="@style/Widget.OpenDiKey.ColorModeButton"
                    android:text="@string/led_mode_off" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colorSettingModeSolid"
                    style="@style/Widget.OpenDiKey.ColorModeButton"
                    android:text="@string/led_mode_solid" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colorSettingModeBreath"
                    style="@style/Widget.OpenDiKey.ColorModeButton"
                    android:text="@string/led_mode_breath" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colorSettingModeBlink"
                    style="@style/Widget.OpenDiKey.ColorModeButton"
                    android:text="@string/led_mode_blink" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/colorSettingModeFlow"
                    style="@style/Widget.OpenDiKey.ColorModeButton"
                    android:text="@string/led_mode_flow" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
        <LinearLayout style="@style/ColorSettingRow">
            <TextView android:id="@+id/colorSettingBrightnessLabel" style="@style/ColorSettingLabel" />
            <SeekBar android:id="@+id/colorSettingBrightness" style="@style/ColorSettingSeek"
                android:max="255" android:progress="255" />
        </LinearLayout>
        <LinearLayout style="@style/ColorSettingRow">
            <TextView android:id="@+id/colorSettingRedLabel" style="@style/ColorSettingLabel" />
            <SeekBar android:id="@+id/colorSettingRed" style="@style/ColorSettingSeek" android:max="255" />
        </LinearLayout>
        <LinearLayout style="@style/ColorSettingRow">
            <TextView android:id="@+id/colorSettingGreenLabel" style="@style/ColorSettingLabel" />
            <SeekBar android:id="@+id/colorSettingGreen" style="@style/ColorSettingSeek" android:max="255" />
        </LinearLayout>
        <LinearLayout style="@style/ColorSettingRow">
            <TextView android:id="@+id/colorSettingBlueLabel" style="@style/ColorSettingLabel" />
            <SeekBar android:id="@+id/colorSettingBlue" style="@style/ColorSettingSeek" android:max="255" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/colorSettingSummaryContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/colorSettingSummaryContents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="vertical">
                <View
                    android:id="@+id/colorSettingSummarySwatch"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_color_bar_swatch" />
                <TextView
                    android:id="@+id/colorSettingSummaryTitle"
                    style="@style/ColorSettingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
            <TextView android:id="@+id/colorSettingSummaryHex"
                style="@style/ColorSettingSummaryValue"
                android:layout_width="match_parent" android:layout_height="56dp" android:layout_weight="0" />
            <TextView android:id="@+id/colorSettingSummarySaturation" style="@style/ColorSettingSummaryValue" />
            <TextView android:id="@+id/colorSettingSummaryMode" style="@style/ColorSettingSummaryValue" />
            <TextView android:id="@+id/colorSettingSummaryBrightness" style="@style/ColorSettingSummaryValue" />
            <TextView android:id="@+id/colorSettingSummaryRed" style="@style/ColorSettingSummaryValue" />
            <TextView android:id="@+id/colorSettingSummaryGreen" style="@style/ColorSettingSummaryValue" />
            <TextView android:id="@+id/colorSettingSummaryBlue" style="@style/ColorSettingSummaryValue" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
