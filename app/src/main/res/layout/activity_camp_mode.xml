<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    tools:context=".CampModeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/view_modes_tabs" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/camp_mode_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/campModeEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/camp_mode_enable" />

        <TextView
            android:id="@+id/campModeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/camp_mode_idle"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
            android:textColor="@color/text_muted" />

        <LinearLayout
            android:id="@+id/campModeChecklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <CheckBox
                    android:id="@+id/campStepDikey"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_dikey" />
                <CheckBox
                    android:id="@+id/campStepBluetooth"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_bluetooth" />
                <CheckBox
                    android:id="@+id/campStepClimate"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_climate" />
                <CheckBox
                    android:id="@+id/campStepWindows"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_windows" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <CheckBox
                    android:id="@+id/campStepHeadlights"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_headlights" />
                <CheckBox
                    android:id="@+id/campStepDrls"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_drls" />
                <CheckBox
                    android:id="@+id/campStepCluster"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_cluster" />
                <CheckBox
                    android:id="@+id/campStepHud"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_hud" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <CheckBox
                    android:id="@+id/campStepMedia"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_media" />
                <CheckBox
                    android:id="@+id/campStepScreen"
                    style="@style/Widget.OpenDiKey.CampStep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_mode_step_screen" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/campModeReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textIsSelectable="true"
            android:textColor="@color/text_primary"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />
    </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/campModeStopWindows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:text="@string/camp_test_windows_stop" />
</LinearLayout>
