<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hub_title"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/mainConnDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="@color/text_muted" />

            <TextView
                android:id="@+id/mainConnStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dikey_state_disconnected"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                android:textColor="@color/text_muted" />

            <LinearLayout
                android:id="@+id/mainWifiRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/tyre_ok" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_state_connected"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/homeVersionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/text_muted"
            tools:text="local" />

        <ImageButton
            android:id="@+id/mainDebugButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/debug_menu_title"
            android:padding="12dp"
            android:src="@drawable/ic_debug"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/mainSettingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_menu_title"
            android:padding="12dp"
            android:src="@drawable/ic_settings"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:id="@+id/homePageContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_floating_panel"
            android:clipToOutline="true"
            android:elevation="6dp" />

        <FrameLayout
            android:id="@+id/homeSidebar"
            android:layout_width="88dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_frosted_sidebar"
            android:clipToOutline="true"
            android:elevation="6dp">

            <View
                android:id="@+id/homeNavigationHighlight"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_home_navigation_item"
                android:importantForAccessibility="no"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="6dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/homeVehicleInfoButton"
                            style="@style/HomeNavigationItem"
                            android:contentDescription="@string/vehicle_info_title">
                            <ImageView style="@style/HomeNavigationIcon" android:src="@drawable/ic_dial" />
                            <TextView style="@style/HomeNavigationLabel" android:text="@string/vehicle_info_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeControlsBarButton"
                            style="@style/HomeNavigationItem"
                            android:contentDescription="@string/controls_bar_title"
                            android:visibility="gone">
                            <ImageView style="@style/HomeNavigationIcon" android:src="@drawable/ic_button" />
                            <TextView style="@style/HomeNavigationLabel" android:text="@string/controls_bar_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeAdasButton"
                            style="@style/HomeNavigationItem"
                            android:contentDescription="@string/adas_title">
                            <ImageView
                                android:id="@+id/homeAdasIcon"
                                style="@style/HomeNavigationIcon"
                                android:src="@drawable/ic_adas" />
                            <TextView style="@style/HomeNavigationLabel" android:text="@string/adas_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/homeModesButton"
                            style="@style/HomeNavigationItem"
                            android:contentDescription="@string/modes_title">
                            <ImageView style="@style/HomeNavigationIcon" android:src="@drawable/ic_pet_paw" android:tint="@color/accent_orange" />
                            <TextView style="@style/HomeNavigationLabel" android:text="@string/modes_title" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <LinearLayout
                    android:id="@+id/homeFridgeButton"
                    style="@style/HomeNavigationItem"
                    android:contentDescription="@string/fridge_title"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/homeFridgeTemperatures"
                        style="@style/HomeNavigationLabel"
                        android:layout_height="40dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textSize="18sp" />
                    <TextView
                        android:id="@+id/homeFridgeStatus"
                        style="@style/HomeNavigationLabel"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/homeFridgeDisconnected"
                        style="@style/HomeNavigationLabel"
                        android:text="@string/fridge_disconnected_tile"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/homeFridgeReconnect"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="@string/fridge_reconnect"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/homeProjectionButton"
                    style="@style/HomeNavigationItem"
                    android:visibility="invisible">
                    <ImageView
                        android:id="@+id/homeProjectionIcon"
                        style="@style/HomeNavigationIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp" />
                    <TextView android:id="@+id/homeProjectionTitle" style="@style/HomeNavigationLabel" />
                    <TextView
                        android:id="@+id/homeProjectionSubtitle"
                        style="@style/HomeNavigationLabel"
                        android:maxLines="3"
                        android:text="@string/projection_home_subtitle"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
