<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_info_block"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_card_attitude"
        android:drawablePadding="8dp"
        android:includeFontPadding="false"
        android:text="@string/vehicle_info_block_attitude"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
        android:textColor="@color/heading"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <com.sphy.airconcontroller.ui.AttitudeHorizonView
            android:id="@+id/attitudeRollHorizon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1" />

        <com.sphy.airconcontroller.ui.AttitudeHorizonView
            android:id="@+id/attitudePitchHorizon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
