<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboardFridgeCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/dashboardFridgeLogo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/fridge_unknown_name"
        android:scaleType="fitCenter"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:src="@drawable/evakool_logo" />

    <TextView
        android:id="@+id/homeFridgeTemperatures"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/homeFridgeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:textColor="@color/text_muted" />

    <TextView
        android:id="@+id/homeFridgeDisconnected"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/dashboard_fridge_disconnected"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body1"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <Button
        android:id="@+id/homeFridgeReconnect"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/fridge_reconnect"
        android:visibility="gone" />
</LinearLayout>
