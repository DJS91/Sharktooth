<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="top"
    android:orientation="horizontal">

    <com.sphy.airconcontroller.ui.DashboardTitleView
        android:id="@+id/infoBlockTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:shadowColor="@color/dashboard_card_background"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle2"
        android:textColor="@color/heading"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/infoBlockHero"
            style="@style/DashboardHeroValue"
            android:text="@string/dashboard_value_unavailable" />

        <TextView
            android:id="@+id/infoBlockHeroLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:textColor="@color/text_muted"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
